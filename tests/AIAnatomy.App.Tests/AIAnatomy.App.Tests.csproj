<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only tests that need WPF. WpfMath's parser cannot be used from the cross-platform test projects:
       XamlMath.Shared alone lacks the predefined formulas (\log, \exp, \cdots, ...) that WpfMath adds. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\content\lessons\**\*" Link="content\lessons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AIAnatomy.Lessons\AIAnatomy.Lessons.csproj" />
  </ItemGroup>
</Project>
