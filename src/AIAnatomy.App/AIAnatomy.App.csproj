<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>AIAnatomy.App</AssemblyName>
    <RootNamespace>AIAnatomy.App</RootNamespace>
    <ApplicationIcon>AIAnatomy.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIAnatomy.Presentation\AIAnatomy.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lessons, sources, texts and shipped models sit beside the exe (AppPaths.Content). -->
    <None Include="..\..\content\**\*" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
