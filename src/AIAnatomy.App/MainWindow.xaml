<Window x:Class="AIAnatomy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation"
        xmlns:lessons="clr-namespace:AIAnatomy.Lessons;assembly=AIAnatomy.Lessons"
        xmlns:models="clr-namespace:AIAnatomy.Models.Language;assembly=AIAnatomy.Models"
        xmlns:c="clr-namespace:AIAnatomy.App.Controls"
        xmlns:v="clr-namespace:AIAnatomy.App.Views"
        x:Name="Root"
        Title="AIAnatomy" Width="1600" Height="1000" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="{DynamicResource BodyFontSize}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />

        <!-- Lab views, chosen by view-model type. Each later lab adds its DataTemplate here. -->
        <DataTemplate DataType="{x:Type labs:ComingLaterLabViewModel}">
            <v:ComingLaterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type labs:RulesVsLearningLabViewModel}"><v:RulesVsLearningView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:ArchitectureMapLabViewModel}"><v:ArchitectureMapView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:TokensLabViewModel}"><v:TokensView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:PositionLabViewModel}"><v:PositionView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:EmbeddingsLabViewModel}"><v:EmbeddingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:AttentionLabViewModel}"><v:AttentionView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:MultiHeadLabViewModel}"><v:MultiHeadView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:FeedForwardLabViewModel}"><v:FeedForwardView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:ResidualLabViewModel}"><v:ResidualView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:SamplingLabViewModel}"><v:SamplingView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:LearningLabViewModel}"><v:LearningView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:TrainLabViewModel}"><v:TrainView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:StepThroughLabViewModel}"><v:StepThroughView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:ScaleLabViewModel}"><v:ScaleView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:FamilyTreeLabViewModel}"><v:FamilyTreeView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:ExpertSystemLabViewModel}"><v:ExpertSystemView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:SearchLabViewModel}"><v:SearchView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:ClassicMlLabViewModel}"><v:ClassicMlView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:RewardLabViewModel}"><v:RewardView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:FiltersLabViewModel}"><v:FiltersView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:DigitNetworkLabViewModel}"><v:DigitNetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type labs:MemoryNetworkLabViewModel}"><v:MemoryNetworkView /></DataTemplate>

        <DataTemplate x:Key="ModelEntryTemplate" DataType="{x:Type models:ModelEntry}">
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name, Mode=OneWay}" /><Run x:Name="Note" Text="" />
            </TextBlock>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReadable}" Value="False">
                    <Setter TargetName="Note" Property="Text" Value=" (cannot be used)" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Map}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Parts}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Whole}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Family}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Beyond}" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Map}" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Parts}" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Whole}" />
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Family}" />
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static lessons:Section.Beyond}" />
    </Window.InputBindings>

    <DockPanel x:Name="Shell" Background="{DynamicResource WindowBrush}">

        <!-- Slim top bar: the app name, the model picker and the Reset, Sources and Settings buttons (they wrap when the text is large). -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,6,12,2">
            <WrapPanel>
                <TextBlock Text="AIAnatomy" FontWeight="Bold" FontSize="{DynamicResource HeadingFontSize}" VerticalAlignment="Center"
                           Margin="0,0,24,4" AutomationProperties.HeadingLevel="Level1" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <ComboBox x:Name="ModelPicker" Width="340" ItemsSource="{Binding ModelEntries}" SelectedItem="{Binding SelectedModelEntry}"
                              ItemTemplate="{StaticResource ModelEntryTemplate}" AutomationProperties.Name="Model"
                              ToolTip="The model the labs use">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="IsEnabled" Value="{Binding IsReadable}" />
                                <Setter Property="ToolTip" Value="{Binding Problem}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Button Content="Reset" Command="{Binding ResetLabCommand}" ToolTip="Put this lab back to how it started" Margin="16,4,4,4" />
                    <Button Content="Sources" Command="{Binding ShowSourcesCommand}" ToolTip="The papers and books behind the lessons" />
                    <Button Content="Settings" Command="{Binding ShowSettingsCommand}" ToolTip="Text size, colours and progress" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Status messages (such as a model that could not be used) are shown here, never only as a sound. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource VisibleIfSet}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap"
                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
        </Border>

        <!-- R35: a Train lab run that carries on while another lesson is open is shown here, in words (never as a sound). -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,6"
                Visibility="{Binding BackgroundStatus, Converter={StaticResource VisibleIfSet}}">
            <TextBlock Text="{Binding BackgroundStatus}" TextWrapping="Wrap" c:LiveText.IsLive="True"
                       AutomationProperties.HelpText="Background training" />
        </Border>

        <!-- Left: the Contents | Idea map switch and the contents tree, always there. Right: the lesson page, the idea map, or the
             Sources or Settings page. -->
        <Grid x:Name="Body" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.18*" MinWidth="{DynamicResource TreeColumnWidth}" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ContentsPane" Grid.Column="0" Style="{StaticResource Pane}" Padding="8,12">
                <v:ContentsTreeView x:Name="ContentsTree" />
            </Border>

            <v:LessonPageView x:Name="LessonPage" Grid.Column="2" Visibility="{Binding IsShowingLesson, Converter={StaticResource Visible}}" />
            <v:IdeaMapView x:Name="IdeaMapPage" Grid.Column="2" DataContext="{Binding IdeaMap}"
                           Visibility="{Binding DataContext.IsShowingIdeaMap, ElementName=Root, Converter={StaticResource Visible}}" />
            <v:SourcesView Grid.Column="2" Visibility="{Binding IsShowingSources, Converter={StaticResource Visible}}" />
            <v:SettingsView Grid.Column="2" Visibility="{Binding IsShowingSettings, Converter={StaticResource Visible}}" />

            <!-- Used only by the render-png gallery and full-lab diagnostics; it covers the whole width. -->
            <ContentControl x:Name="DiagnosticPage" Grid.ColumnSpan="3" Visibility="Collapsed" Focusable="False" />
        </Grid>
    </DockPanel>
</Window>
