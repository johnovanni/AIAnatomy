<!-- Light theme. Text on every background here (Window, Surface, Screen) is at least 7:1 (WCAG AAA), muted text at least 7:1, links 6.6:1. Brushes are swapped by ThemeManager; the HeatMap ramp (RampLow/Mid/High) is the same in both themes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="WindowBrush" Color="#F6F5F2" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#E9E7E2" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#4D4B47" />
    <SolidColorBrush x:Key="BorderBrush" Color="#7D7A73" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#DDDAD3" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0B57A4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1D5A92" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="StatusBrush" Color="#FFF1C7" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="#3A2B00" />
    <SolidColorBrush x:Key="LinkBrush" Color="#0B57A4" />
    <SolidColorBrush x:Key="Series1Brush" Color="#1D5A92" />
    <SolidColorBrush x:Key="Series2Brush" Color="#A84B12" />
    <SolidColorBrush x:Key="Series3Brush" Color="#2E7D32" />
    <SolidColorBrush x:Key="Series4Brush" Color="#6A3D9A" />
    <SolidColorBrush x:Key="AxisBrush" Color="#5F5C56" />
    <SolidColorBrush x:Key="BlockedBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="BlockedLineBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#E9E7E2" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8F8C85" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="LabelPlateBrush" Color="#FFFFFF" />
    <!-- Screens (inset displays), connection gold and the part palette (Okabe-Ito flavoured; each at least 3:1 on Surface and Screen, and, within a group, at least 15 CIE76 DeltaE apart, 8 under protanopia and deuteranopia simulation; the groups are the transformer parts and the family parts with "later"). -->
    <SolidColorBrush x:Key="ScreenBrush" Color="#EAEFF6" />
    <SolidColorBrush x:Key="ScreenTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ConnectionBrush" Color="#8A5F00" />
    <SolidColorBrush x:Key="PartIntroBrush" Color="#1E81C2" />
    <SolidColorBrush x:Key="PartTokensBrush" Color="#A36A01" />
    <SolidColorBrush x:Key="PartEmbeddingsBrush" Color="#146C4F" />
    <SolidColorBrush x:Key="PartPositionBrush" Color="#873A0F" />
    <SolidColorBrush x:Key="PartAttentionBrush" Color="#CA2F32" />
    <SolidColorBrush x:Key="PartFeedforwardBrush" Color="#C62CA4" />
    <SolidColorBrush x:Key="PartResidualBrush" Color="#713AB9" />
    <SolidColorBrush x:Key="PartOutputBrush" Color="#6067FF" />
    <SolidColorBrush x:Key="PartLearningBrush" Color="#085757" />
    <SolidColorBrush x:Key="PartWholeBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="PartLaterBrush" Color="#848484" />
    <SolidColorBrush x:Key="PartFamilyBrush" Color="#206050" />
    <SolidColorBrush x:Key="PartRulesBrush" Color="#604A20" />
    <SolidColorBrush x:Key="PartSearchBrush" Color="#042895" />
    <SolidColorBrush x:Key="PartClassicBrush" Color="#46931F" />
    <SolidColorBrush x:Key="PartRewardBrush" Color="#AC3999" />
    <SolidColorBrush x:Key="PartVisionBrush" Color="#CC2200" />
    <SolidColorBrush x:Key="PartMemoryBrush" Color="#4B2A66" />
    <SolidColorBrush x:Key="PartDiffusionBrush" Color="#858C54" />
    <!-- The classic machine learning lab's classes A, B and C (Okabe-Ito blue, orange and reddish purple; each at least 3:1 on Surface and Screen and, among themselves, at least 15 CIE76 DeltaE apart, 8 under protanopia and deuteranopia). Points also differ in shape: circle, square, triangle. -->
    <SolidColorBrush x:Key="ClassABrush" Color="#0072B2" />
    <SolidColorBrush x:Key="ClassBBrush" Color="#C04F00" />
    <SolidColorBrush x:Key="ClassCBrush" Color="#A0357A" />
    <sys:Double x:Key="ScreenGlowOpacity">0</sys:Double>
    <!-- Single-hue sequential ramp for heat maps, light (small) to dark (large). -->
    <Color x:Key="RampLowColor">#F1F6FB</Color>
    <Color x:Key="RampMidColor">#6BAED6</Color>
    <Color x:Key="RampHighColor">#08306B</Color>
    <!-- Diverging ramp for signed values (feature maps, the memory): blue below zero, near-white at zero, red above zero (the ColorBrewer RdBu ends, which stay apart under the common colour-vision differences). The same in both themes; the readout always gives the number. -->
    <Color x:Key="DivergingLowColor">#2166AC</Color>
    <Color x:Key="DivergingMidColor">#F7F7F7</Color>
    <Color x:Key="DivergingHighColor">#B2182B</Color>
    <!-- Paper-and-ink ramp for the digit pictures of lessons 4.6 and 4.7: white (no ink) to near-black (all ink), so blue
         keeps one meaning beside them, "below zero" on the feature maps (final review M8). The same in both themes. -->
    <Color x:Key="InkLowColor">#FFFFFF</Color>
    <Color x:Key="InkMidColor">#969696</Color>
    <Color x:Key="InkHighColor">#1A1A1A</Color>
</ResourceDictionary>
