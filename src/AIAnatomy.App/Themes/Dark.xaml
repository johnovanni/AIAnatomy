<!-- Dark theme. Text on every background here (Window, Surface, Screen) is at least 11:1, muted text at least 7.8:1, links 8.7:1. Brushes are swapped by ThemeManager; the HeatMap ramp (RampLow/Mid/High) is the same in both themes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="WindowBrush" Color="#16171A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2125" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#2A2C31" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#C2C2C8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#8C8C96" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#393B41" />
    <SolidColorBrush x:Key="FocusBrush" Color="#8CC4FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8CC4FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B0B0D" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#2E3036" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="StatusBrush" Color="#4A3A00" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="#FFF0C2" />
    <SolidColorBrush x:Key="LinkBrush" Color="#8CC4FF" />
    <SolidColorBrush x:Key="Series1Brush" Color="#7DB8F0" />
    <SolidColorBrush x:Key="Series2Brush" Color="#F2A65E" />
    <SolidColorBrush x:Key="Series3Brush" Color="#7CCB7F" />
    <SolidColorBrush x:Key="Series4Brush" Color="#C9A0F0" />
    <SolidColorBrush x:Key="AxisBrush" Color="#A6A6AE" />
    <!-- The point-cloud plots' target rings: the same look as before (muted text at 55% on Surface), at least 3.7:1 on Window, Surface and Screen (AA-043). -->
    <SolidColorBrush x:Key="TargetRingBrush" Color="#797A7F" />
    <SolidColorBrush x:Key="BlockedBrush" Color="#55565B" />
    <SolidColorBrush x:Key="BlockedLineBrush" Color="#A0A0A6" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#2A2C31" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9A9AA4" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="LabelPlateBrush" Color="#1F2125" />
    <!-- Screens (inset displays), connection gold and the part palette (Okabe-Ito flavoured; each at least 3:1 on Surface and Screen, and, within a group, at least 15 CIE76 DeltaE apart, 8 under protanopia and deuteranopia simulation; the groups are the transformer parts and the family parts with "later"). -->
    <SolidColorBrush x:Key="ScreenBrush" Color="#0E0F11" />
    <SolidColorBrush x:Key="ScreenTextBrush" Color="#E6EEF8" />
    <SolidColorBrush x:Key="ConnectionBrush" Color="#FFC83D" />
    <SolidColorBrush x:Key="PartIntroBrush" Color="#7CEFFF" />
    <SolidColorBrush x:Key="PartTokensBrush" Color="#FEAB1C" />
    <SolidColorBrush x:Key="PartEmbeddingsBrush" Color="#24CF9E" />
    <SolidColorBrush x:Key="PartPositionBrush" Color="#FDDF55" />
    <SolidColorBrush x:Key="PartAttentionBrush" Color="#FE8743" />
    <SolidColorBrush x:Key="PartFeedforwardBrush" Color="#EA7CD6" />
    <SolidColorBrush x:Key="PartResidualBrush" Color="#6788F9" />
    <SolidColorBrush x:Key="PartOutputBrush" Color="#BFA2FF" />
    <SolidColorBrush x:Key="PartLearningBrush" Color="#80C182" />
    <SolidColorBrush x:Key="PartWholeBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="PartLaterBrush" Color="#9B9B9B" />
    <SolidColorBrush x:Key="PartFamilyBrush" Color="#2EFAFA" />
    <SolidColorBrush x:Key="PartRulesBrush" Color="#EAA23E" />
    <SolidColorBrush x:Key="PartSearchBrush" Color="#2E61FA" />
    <SolidColorBrush x:Key="PartClassicBrush" Color="#A7E892" />
    <SolidColorBrush x:Key="PartRewardBrush" Color="#EA3ECD" />
    <SolidColorBrush x:Key="PartVisionBrush" Color="#D24235" />
    <SolidColorBrush x:Key="PartMemoryBrush" Color="#D38CFF" />
    <SolidColorBrush x:Key="PartDiffusionBrush" Color="#F7FF00" />
    <!-- The classic machine learning lab's classes A, B and C (Okabe-Ito blue, orange and reddish purple; each at least 3:1 on Surface and Screen and, among themselves, at least 15 CIE76 DeltaE apart, 8 under protanopia and deuteranopia). Points also differ in shape: circle, square, triangle. -->
    <SolidColorBrush x:Key="ClassABrush" Color="#56B4E9" />
    <SolidColorBrush x:Key="ClassBBrush" Color="#E69F00" />
    <SolidColorBrush x:Key="ClassCBrush" Color="#CC79A7" />
    <sys:Double x:Key="ScreenGlowOpacity">0.45</sys:Double>
    <!-- Single-hue sequential ramp for heat maps, light (small) to dark (large). -->
    <Color x:Key="RampLowColor">#F1F6FB</Color>
    <Color x:Key="RampMidColor">#6BAED6</Color>
    <Color x:Key="RampHighColor">#08306B</Color>
    <!-- Diverging ramp for signed values (feature maps, the memory): blue below zero, near-white at zero, red above zero (the ColorBrewer RdBu ends, which stay apart under the common colour-vision differences). The same in both themes; the readout always gives the number. -->
    <Color x:Key="DivergingLowColor">#2166AC</Color>
    <Color x:Key="DivergingMidColor">#F7F7F7</Color>
    <Color x:Key="DivergingHighColor">#B2182B</Color>
    <!-- Paper-and-ink ramp for the digit pictures of lessons 4.6 and 4.7: white (no ink) to near-black (all ink), so blue
         keeps one meaning beside them, "below zero" on the feature maps (final review M8). The same in both themes. -->
    <Color x:Key="InkLowColor">#FFFFFF</Color>
    <Color x:Key="InkMidColor">#969696</Color>
    <Color x:Key="InkHighColor">#1A1A1A</Color>
</ResourceDictionary>
