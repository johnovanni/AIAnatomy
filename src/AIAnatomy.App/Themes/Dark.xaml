<!-- Dark theme. Text on every background here is at least 11:1, muted text at least 7.8:1, links 8.7:1. Brushes are swapped by ThemeManager; the HeatMap ramp (RampLow/Mid/High) is the same in both themes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#16171A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2125" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#2A2C31" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#C2C2C8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#8C8C96" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#393B41" />
    <SolidColorBrush x:Key="FocusBrush" Color="#8CC4FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8CC4FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B0B0D" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#2E3036" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="StatusBrush" Color="#4A3A00" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="#FFF0C2" />
    <SolidColorBrush x:Key="LinkBrush" Color="#8CC4FF" />
    <SolidColorBrush x:Key="Series1Brush" Color="#7DB8F0" />
    <SolidColorBrush x:Key="Series2Brush" Color="#F2A65E" />
    <SolidColorBrush x:Key="Series3Brush" Color="#7CCB7F" />
    <SolidColorBrush x:Key="Series4Brush" Color="#C9A0F0" />
    <SolidColorBrush x:Key="AxisBrush" Color="#A6A6AE" />
    <SolidColorBrush x:Key="BlockedBrush" Color="#55565B" />
    <SolidColorBrush x:Key="BlockedLineBrush" Color="#A0A0A6" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#2A2C31" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9A9AA4" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="LabelPlateBrush" Color="#1F2125" />
    <!-- Single-hue sequential ramp for heat maps, light (small) to dark (large). -->
    <Color x:Key="RampLowColor">#F1F6FB</Color>
    <Color x:Key="RampMidColor">#6BAED6</Color>
    <Color x:Key="RampHighColor">#08306B</Color>
</ResourceDictionary>
