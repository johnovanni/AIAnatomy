<UserControl x:Class="AIAnatomy.App.Views.FamilyTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views">
    <!-- DataContext: FamilyTreeLabViewModel. The bubbles and lines are built in the code-behind (they depend on measured sizes). -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />

        <!-- A bubble: a rounded box edged in its part's colour. The chosen one is filled and has a thicker edge (the code-behind
             trades padding for edge, so the bubble keeps its size). -->
        <Style x:Key="FamilyBubbleButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Follows the body text size: the view measures its bubbles again when this changes. -->
        <TextBlock x:Name="SizeProbe" Visibility="Collapsed" FontSize="{DynamicResource BodyFontSize}" />

        <TextBlock Style="{StaticResource BodyText}"
                   Text="Each line joins a member of the family to the branch it belongs to. Choose a bubble to see what it is." />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Text="Enter on the chosen bubble opens its lesson. A bubble marked later is a lesson not built yet." />

        <Border Style="{StaticResource ScreenFrame}" Padding="0">
            <ScrollViewer x:Name="TreeScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" AutomationProperties.Name="Family tree">
                <Canvas x:Name="TreeCanvas" HorizontalAlignment="Center" />
            </ScrollViewer>
        </Border>

        <!-- The card: what the chosen bubble is, what it is good and bad at, a real example, and its lesson. -->
        <c:Screen ScreenName="card" HorizontalAlignment="Stretch" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="EmptyCard" Style="{StaticResource MutedText}" Text="Choose a bubble to see what that kind of program is." />
                <StackPanel x:Name="CardBody" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource HeadingText}" Margin="0,0,0,6" Text="{Binding Card.Title}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Card.WhatItIs}" />
                    <StackPanel Visibility="{Binding Card.GoodAt, Converter={StaticResource VisibleIfSet}}">
                        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,2" Text="Good at" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Card.GoodAt}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Card.BadAt, Converter={StaticResource VisibleIfSet}}">
                        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,2" Text="Bad at" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Card.BadAt}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Card.Example, Converter={StaticResource VisibleIfSet}}">
                        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,2" Text="A real example" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Card.Example}" />
                    </StackPanel>
                    <Button x:Name="OpenLessonButton" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnOpenLessonClick"
                            Visibility="{Binding Card.OpenLessonText, Converter={StaticResource VisibleIfSet}}"
                            AutomationProperties.Name="{Binding Card.OpenLessonText}" ToolTip="Or press Enter again on the chosen bubble">
                        <TextBlock Text="{Binding Card.OpenLessonText}" TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </c:Screen>
    </StackPanel>
</UserControl>
