<UserControl x:Class="AIAnatomy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:AIAnatomy.App.Views">
    <!-- DataContext: MainViewModel; the settings themselves are MainViewModel.SettingsPage. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
    </UserControl.Resources>
    <Border Style="{StaticResource Pane}" Padding="24,16">
        <ScrollViewer Style="{StaticResource PaneScroller}" AutomationProperties.Name="Settings">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Back to the lesson" VerticalAlignment="Top" Command="{Binding BackToLessonCommand}" />
                    <TextBlock Style="{StaticResource HeadingText}" Text="Settings" />
                </DockPanel>
                <StackPanel DataContext="{Binding SettingsPage}">
                    <TextBlock Style="{StaticResource MutedText}" Text="Changes show straight away and are saved for next time." />

                    <TextBlock Style="{StaticResource SubheadingText}" Text="Text size" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="{StaticResource NumberFont}"
                                   MinWidth="90" Text="{Binding BodyFontSize, StringFormat={}{0:0} pt}" />
                        <Slider Minimum="{Binding MinimumFontSize}" Maximum="{Binding MaximumFontSize}"
                                Value="{Binding BodyFontSize}" SmallChange="1" LargeChange="2" TickFrequency="1"
                                IsSnapToTickEnabled="True" AutomationProperties.Name="Text size" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="From 10 pt to 24 pt. Titles and headings grow with it." />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeadingText}" Margin="0,0,0,4" Text="A heading looks like this" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0">
                                <Run Text="Lesson text looks like this. Numbers look like this:" />
                                <Run Text="0.41273849201" FontFamily="{StaticResource NumberFont}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SubheadingText}" Text="Colours" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Light" IsChecked="{Binding IsLightTheme}" />
                        <RadioButton Content="Dark" IsChecked="{Binding IsDarkTheme}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SubheadingText}" Text="Progress" />
                    <TextBlock Style="{StaticResource MutedText}" Text="The contents marks which lessons you have opened and checked yourself on. Reset forgets all of them." />
                    <!-- Reset progress stays where it is (disabled while the question shows), and the question and its buttons
                         appear below it with the safe answer first: so a double-click's second click lands on the disabled
                         button, never on "Yes" (re-review N1), and the keyboard moves to "Keep it" (N2). -->
                    <Button Content="Reset progress" Command="{Binding ResetProgressCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            AutomationProperties.Name="Reset progress" />
                    <StackPanel x:Name="ResetQuestion" Margin="0,8,0,0" Visibility="{Binding IsConfirmingReset, Converter={StaticResource BoolToVisible}}"
                                IsVisibleChanged="OnResetQuestionShown">
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite"
                                   Text="Forget every opened and checked mark? This cannot be undone." />
                        <WrapPanel>
                            <Button x:Name="KeepProgressButton" Content="Keep it" Command="{Binding CancelResetProgressCommand}" Margin="0,0,8,4" />
                            <Button Content="Yes, forget my progress" Command="{Binding ConfirmResetProgressCommand}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"
                               Text="{Binding ProgressMessage}" Visibility="{Binding ProgressMessage, Converter={StaticResource VisibleIfSet}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
