<UserControl x:Class="AIAnatomy.App.Views.AttentionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation"
             xmlns:vis="clr-namespace:AIAnatomy.Presentation.Visuals;assembly=AIAnatomy.Presentation">
    <!-- DataContext: AttentionLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />

        <!-- A vector's two numbers, as boxes (the keyboard alternative to dragging). -->
        <DataTemplate x:Key="NumberBoxes" DataType="{x:Type vis:DragHandle}">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <TextBlock MinWidth="48" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="x" />
                <TextBox Width="84" Text="{Binding X, StringFormat=0.##, ConverterCulture={x:Static glob:CultureInfo.InvariantCulture}}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} x}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0,4,0" Text="y" />
                <TextBox Width="84" Text="{Binding Y, StringFormat=0.##, ConverterCulture={x:Static glob:CultureInfo.InvariantCulture}}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} y}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DotLine" DataType="{x:Type labs:ToyRow}">
            <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding DotLine}" />
        </DataTemplate>
        <DataTemplate x:Key="ScaledLine" DataType="{x:Type labs:ToyRow}">
            <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding ScaledLine}" />
        </DataTemplate>
        <DataTemplate x:Key="WeightLine" DataType="{x:Type labs:ToyRow}">
            <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding WeightLine}" />
        </DataTemplate>
        <DataTemplate x:Key="ShareLine" DataType="{x:Type labs:ToyRow}">
            <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding ShareLine}" />
        </DataTemplate>

        <!-- The 17 letters in equal-width columns; a bracket over each copy names it. -->
        <ItemsPanelTemplate x:Key="SeventeenColumns">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /><ColumnDefinition Width="*" MinWidth="44" /></Grid.ColumnDefinitions>
            </Grid>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="SequenceCell" DataType="{x:Type labs:SequenceCell}">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding Letter}" />
                <TextBlock FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Text="{Binding Position}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CopyBracket" DataType="{x:Type labs:CopySpan}">
            <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="3,3,3,0" Margin="3,0" Padding="0,0,0,2">
                <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource SmallFontSize}" FontWeight="SemiBold" Text="{Binding Name}" />
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel /></ItemsPanelTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- ================= Part 1: the toy ================= -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,4" Text="1. Attention by hand: a toy with two numbers per vector" />
        <TextBlock Style="{StaticResource BodyText}"
                   Text="One token (the query, Q) looks at two to four others (the keys, K). Each key has a value (V) to hand over. Q · K measures how well they match; the best matches get the most weight; the answer is the weights times the values, added up. Move the points, or type the numbers." />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add a key" Command="{Binding Toy.AddKeyCommand}" />
            <Button Content="Remove a key" Command="{Binding Toy.RemoveKeyCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Toy.KeyCount, StringFormat={}{0} keys}" />
        </StackPanel>
        <TextBlock Style="{StaticResource PaneTitle}" Text="Query and keys" />
        <c:DragPlot Handles="{Binding Toy.KeyPlotHandles}" XAxisTitle="x" YAxisTitle="y" HorizontalAlignment="Left" Width="420" AutomationProperties.Name="Plot of the query and the keys" />
        <WrapPanel Margin="0,8,0,0">
            <ContentControl Content="{Binding Toy.Query}" ContentTemplate="{StaticResource NumberBoxes}" Focusable="False" />
            <ItemsControl ItemsSource="{Binding Toy.ActiveKeys}" ItemTemplate="{StaticResource NumberBoxes}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </WrapPanel>
        <TextBlock Style="{StaticResource PaneTitle}" Margin="0,8,0,0" Text="Values and the answer" />
        <c:DragPlot Handles="{Binding Toy.ValuePlotHandles}" XAxisTitle="x" YAxisTitle="y" HorizontalAlignment="Left" Width="420" AutomationProperties.Name="Plot of the values and the answer" />
        <ItemsControl ItemsSource="{Binding Toy.ActiveValues}" ItemTemplate="{StaticResource NumberBoxes}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Style="{StaticResource Pane}" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource PaneTitle}" Text="Step 1. Dot products: how well does the query match each key?" />
                <ItemsControl ItemsSource="{Binding Toy.Rows}" ItemTemplate="{StaticResource DotLine}" Focusable="False" />
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,8,0,0" Text="Step 2. Scale the scores" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Toy.ScaleText}" />
                <ItemsControl ItemsSource="{Binding Toy.Rows}" ItemTemplate="{StaticResource ScaledLine}" Focusable="False" />
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,8,0,0" Text="Step 3. Softmax: turn the scores into weights" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Toy.SoftmaxText}" />
                <ItemsControl ItemsSource="{Binding Toy.Rows}" ItemTemplate="{StaticResource WeightLine}" Focusable="False" />
                <c:ProbabilityBars Items="{Binding Toy.WeightBars}" AutomationProperties.Name="Attention weights of the toy" />
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,8,0,0" Text="Step 4. Weighted sum of the values" />
                <ItemsControl ItemsSource="{Binding Toy.Rows}" ItemTemplate="{StaticResource ShareLine}" Focusable="False" />
                <TextBlock FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Toy.AnswerText}" />
            </StackPanel>
        </Border>

        <!-- ================= Part 2: real attention ================= -->
        <TextBlock Style="{StaticResource SubheadingText}" Text="2. The real thing: attention in the model you are using" />
        <TextBlock Style="{StaticResource MutedText}" Text="Your text" Margin="0,0,0,2" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                 AutomationProperties.Name="Your text" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Style="{StaticResource MutedText}" Text="␣ is a space, ↵ a new line, � a character the model has never seen. Each token is numbered by its position." />
        <WrapPanel Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Layer" />
            <ComboBox Width="80" Margin="0,0,16,4" ItemsSource="{Binding LayerNumbers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Layer" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Head" />
            <ComboBox Width="80" Margin="0,0,16,4" ItemsSource="{Binding HeadNumbers}" SelectedItem="{Binding Head}" AutomationProperties.Name="Head" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,4" Style="{StaticResource MutedText}" Text="{Binding RealCaption}" />
        </WrapPanel>
        <c:HeatMap Values="{Binding RealWeights}" RowLabels="{Binding TokenLabels}" ColumnLabels="{Binding TokenLabels}"
                   RowAxisTitle="the token that is looking" ColumnAxisTitle="the token it looks at" Minimum="0" Maximum="1"
                   AutomationProperties.Name="Attention weights of the chosen head" />
        <TextBlock Style="{StaticResource MutedText}" Text="{x:Static labs:AttentionLabViewModel.FutureNote}" />

        <!-- ================= Part 3: induction heads ================= -->
        <TextBlock Style="{StaticResource SubheadingText}" Text="3. An experiment: can attention learn to copy?" />
        <TextBlock Style="{StaticResource BodyText}"
                   Text="A tiny model (two layers, two heads each, letters A to O) is shown sequences where a stretch of letters appears twice. To continue the second copy, it has to find the first copy and look at the letter that came after it. A head that does this is called an induction head." />
        <StackPanel DataContext="{Binding Induction}">
            <WrapPanel>
                <Button Content="Show trained demo" Command="{Binding ShowDemoCommand}" ToolTip="Load the model that comes with the app, already trained" />
                <Button Content="Train it yourself" Command="{Binding TrainCommand}" ToolTip="Train a new model from scratch (takes about a minute)" />
                <Button Content="Stop training" Command="{Binding TrainCancelCommand}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Source, StringFormat=Showing: {0}}" Visibility="{Binding Source, Converter={StaticResource VisibleIfSet}}" />

            <StackPanel Visibility="{Binding ProgressText, Converter={StaticResource VisibleIfSet}}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="16" Margin="0,4,0,4" AutomationProperties.Name="Training progress" />
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressText}" />
                <c:LineChart Series="{Binding LossSeries}" XAxisTitle="training step" YAxisTitle="loss" Height="260" />
                <TextBlock Style="{StaticResource MutedText}" Text="{x:Static labs:InductionPanelViewModel.LossNote}" />
            </StackPanel>

            <TextBlock Style="{StaticResource PaneTitle}" Margin="0,12,0,4" Text="An example sequence (letters A to O)" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding CopySpans}" ItemTemplate="{StaticResource CopyBracket}" ItemsPanel="{StaticResource SeventeenColumns}" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding Column}" />
                                <Setter Property="Grid.ColumnSpan" Value="{Binding Length}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding SequenceCells}" ItemTemplate="{StaticResource SequenceCell}" ItemsPanel="{StaticResource SeventeenColumns}" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding Index}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Style="{StaticResource MutedText}"
                       Text="A stretch of letters appears twice; a bracket over each copy names it. The small numbers are positions." />

            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding ScoreSummary}" Visibility="{Binding ScoreSummary, Converter={StaticResource VisibleIfSet}}" />
            <StackPanel Visibility="{Binding HasModel, Converter={StaticResource VisibleIfTrue}}">
                <TextBlock Style="{StaticResource PaneTitle}" Text="Induction score of every head" />
                <TextBlock Style="{StaticResource MutedText}" Text="Average share of attention (100% would be all of it) that each letter of the second copy gives to the letter after its twin in the first copy." />
                <c:ProbabilityBars Items="{Binding InductionBars}" AutomationProperties.Name="Induction scores" />
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,8,0,0" Text="Previous-token score of every head" />
                <TextBlock Style="{StaticResource MutedText}" Text="Average share of attention that each letter gives to the letter just before it." />
                <c:ProbabilityBars Items="{Binding PreviousTokenBars}" AutomationProperties.Name="Previous-token scores" />
            </StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="{x:Static labs:InductionPanelViewModel.CircuitNote}" />

            <TextBlock Style="{StaticResource PaneTitle}" Margin="0,12,0,4" Text="Where one head looks on the example sequence" />
            <WrapPanel>
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Layer" />
                <ComboBox Width="80" Margin="0,0,16,4" ItemsSource="{Binding LayerNumbers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Induction layer" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Head" />
                <ComboBox Width="80" Margin="0,0,16,4" ItemsSource="{Binding HeadNumbers}" SelectedItem="{Binding Head}" AutomationProperties.Name="Induction head" />
            </WrapPanel>
            <c:HeatMap Values="{Binding HeatMap}" RowLabels="{Binding TokenLabels}" ColumnLabels="{Binding TokenLabels}" OutlinedCells="{Binding OutlinedCells}"
                       RowAxisTitle="the letter that is looking" ColumnAxisTitle="the letter it looks at" Minimum="0" Maximum="1"
                       AutomationProperties.Name="Attention of one head on the example sequence" />
            <TextBlock Style="{StaticResource MutedText}" Text="{x:Static labs:InductionPanelViewModel.OutlineNote}" />
        </StackPanel>

        <WrapPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,8" Text="Seed (picks the example sequence and starts the training)" />
            <TextBox Width="110" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>
    </StackPanel>
</UserControl>
