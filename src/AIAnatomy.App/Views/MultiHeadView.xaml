<UserControl x:Class="AIAnatomy.App.Views.MultiHeadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation">
    <!-- DataContext: MultiHeadLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <!-- Array-typed properties cannot be bound by attribute inside a template, so they are set from styles. -->
        <Style x:Key="OutputStrip" TargetType="c:VectorStrip">
            <Setter Property="Values" Value="{Binding Output}" />
        </Style>
        <Style x:Key="DimWhenOff" TargetType="c:HeatMap">
            <Setter Property="Values" Value="{Binding Weights}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Opacity" Value="0.5" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HeadPanel" DataType="{x:Type labs:HeadPanelViewModel}">
            <StackPanel Margin="0,0,12,12" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <CheckBox IsChecked="{Binding IsEnabled}" FontWeight="SemiBold" AutomationProperties.Name="{Binding Title}"
                              ToolTip="Clear this box to switch the head off">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                    </CheckBox>
                    <c:Screen ScreenName="{Binding ScreenName}" HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" />
                            <c:HeatMap RowAxisTitle="looking" ColumnAxisTitle="looked at" Minimum="0" Maximum="1" ShowCellValues="False"
                                       RowLabels="{Binding DataContext.TokenLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       ColumnLabels="{Binding DataContext.TokenLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource DimWhenOff}"
                                       AutomationProperties.Name="{Binding Title, StringFormat={}Attention squares of {0}}" />
                        </StackPanel>
                    </c:Screen>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeadOutput" DataType="{x:Type labs:HeadPanelViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource PaneTitle}" Text="{Binding Title, StringFormat={}Output of {0}}" />
                <c:VectorStrip Style="{StaticResource OutputStrip}" AutomationProperties.Name="{Binding Title, StringFormat={}Output numbers of {0}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Several attention heads work side by side on the same text, each looking for its own thing. Clear a check box to switch a head off (its output becomes zeros) and watch the guesses change." />
        <TextBlock Style="{StaticResource MutedText}" Text="Your text" Margin="0,0,0,2" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" AutomationProperties.Name="Your text" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Style="{StaticResource MutedText}" Text="␣ is a space, ↵ a new line, � a character the model has never seen. Each token is numbered by its position." />

        <WrapPanel Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Layer" />
            <ComboBox MinWidth="80" Margin="0,0,16,4" ItemsSource="{Binding LayerNumbers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Layer" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,4" Style="{StaticResource MutedText}" Text="{Binding LayerCaption}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding DisabledSummary}" />
        <ItemsControl ItemsSource="{Binding Heads}" ItemTemplate="{StaticResource HeadPanel}" Focusable="False" />
        <TextBlock Style="{StaticResource MutedText}" Text="{x:Static labs:AttentionLabViewModel.FutureNote}" />

        <TextBlock Style="{StaticResource SubheadingText}" Text="What the guesses look like" c:LessonAnchor.Name="compare-guesses" />
        <c:Screen ScreenName="guesses" HorizontalAlignment="Stretch">
        <StackPanel>
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding PredictionCaption}" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PaneTitle}" Text="With your choices" />
                <c:ProbabilityBars Items="{Binding Predictions}" AutomationProperties.Name="Guesses with your choices" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource PaneTitle}" Text="With every head working" />
                <c:ProbabilityBars Items="{Binding BasePredictions}" AutomationProperties.Name="Guesses with every head working" />
            </StackPanel>
        </Grid>
        </StackPanel>
        </c:Screen>

        <TextBlock Style="{StaticResource SubheadingText}" Text="Joining the heads at one token" c:LessonAnchor.Name="joining" />
        <WrapPanel Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Token" />
            <ComboBox MinWidth="120" Margin="0,0,16,4" ItemsSource="{Binding PositionChoices}" SelectedIndex="{Binding PositionIndex}" AutomationProperties.Name="Token" />
        </WrapPanel>
        <c:Screen ScreenName="joined" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding VectorCaption}" />
                <ItemsControl ItemsSource="{Binding Heads}" ItemTemplate="{StaticResource HeadOutput}" Focusable="False" />
                <TextBlock Style="{StaticResource PaneTitle}" Text="All the heads joined side by side" />
                <c:VectorStrip Values="{Binding ConcatenatedVector}" AutomationProperties.Name="The heads joined side by side" />
                <TextBlock Style="{StaticResource PaneTitle}" Text="After the output projection (what attention adds to the residual stream)" />
                <c:VectorStrip Values="{Binding ProjectedVector}" AutomationProperties.Name="After the output projection" />
            </StackPanel>
        </c:Screen>
        <TextBlock Style="{StaticResource MutedText}" Text="{x:Static labs:MultiHeadLabViewModel.JoinNote}" />
    </StackPanel>
</UserControl>
