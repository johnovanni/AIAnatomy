<UserControl x:Class="AIAnatomy.App.Views.ArchitectureMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views">
    <!-- DataContext: ArchitectureMapLabViewModel. Clicking a linked box raises the window-wide lesson navigation event. -->
    <UserControl.Resources><v:NullToCollapsedConverter x:Key="VisibleIfSet" /></UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Type some text and watch the model's next-character choices change. Click an underlined box to open its lesson." />
        <TextBlock Style="{StaticResource MutedText}" Text="Your text" Margin="0,0,0,2" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Your text" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="What the model reads (␣ is a space, ↵ a new line, � a character it has never seen)"
                   Visibility="{Binding ShownText, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding ShownText}"
                   AutomationProperties.Name="What the model reads" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}"
                   Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Notice}"
                   Visibility="{Binding Notice, Converter={StaticResource VisibleIfSet}}" />

        <c:NetworkDiagram Nodes="{Binding Nodes}" Edges="{Binding Edges}" Height="{DynamicResource DiagramHeight}" Margin="0,16,0,0" AutomationProperties.Name="Architecture map" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding DiagramCaption}" />

        <TextBlock Style="{StaticResource SubheadingText}" Text="The ten most likely next characters" />
        <TextBlock Style="{StaticResource MutedText}" Text="␣ is a space and ↵ a new line; � stands for a character the model has never seen." />
        <c:ProbabilityBars Items="{Binding Top10}" AutomationProperties.Name="Top 10 next characters" />
    </StackPanel>
</UserControl>
