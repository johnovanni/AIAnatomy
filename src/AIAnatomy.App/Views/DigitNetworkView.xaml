<UserControl x:Class="AIAnatomy.App.Views.DigitNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation"
             x:Name="Root">
    <!-- DataContext: DigitNetworkLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="The whole shipped network reads one 8 by 8 digit: 16 filters, pooling, 32 more filters, pooling again, a fully connected layer of 128 numbers, and then 10 scores that softmax turns into a probability for each digit from 0 to 9." />
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,6" TextWrapping="Wrap"
                   c:LiveText.IsLive="True" Text="{Binding LoadMessage}"
                   Visibility="{Binding LoadMessage, Converter={StaticResource VisibleIfSet}}" />

        <!-- The digit: a test digit (Previous, Next, or a digit 0 to 9, the keyboard path) or a drawing. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,8,0,4" Text="The digit" />
        <WrapPanel Margin="0,0,0,4">
            <Button Style="{StaticResource Chip}" Content="Previous" Command="{Binding PreviousCommand}" ToolTip="The test digit before this one" />
            <Button Style="{StaticResource Chip}" Content="Next" Command="{Binding NextCommand}" ToolTip="The next test digit" Margin="0,0,18,6" />
            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,6" Text="Show a" />
            <ItemsControl ItemsSource="{x:Static labs:DigitNetworkLabViewModel.Digits}" Focusable="False" AutomationProperties.Name="Show a test digit">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Chip}" Content="{Binding}" Padding="10,4"
                                Command="{Binding DataContext.ShowDigitCommand, ElementName=Root}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding StringFormat='Show a test digit {0}'}"
                                ToolTip="{Binding StringFormat='Show the next test digit that is a {0}'}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:DrawingPad x:Name="Pad" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Style="{StaticResource BodyText}"
                           Text="Or draw a digit on the pad with the mouse or a pen. The network only knows the coarse 8 by 8 digits it was trained on, so your drawing is first made into the same kind of 8 by 8 picture, then read as soon as each stroke ends." />
                <Button Style="{StaticResource Chip}" Content="Clear the pad" Click="OnClearPad" HorizontalAlignment="Left" Margin="0,8,0,6"
                        ToolTip="Empty the pad" />
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" c:LiveText.IsLive="True" Text="{Binding Message}"
                           Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Text="It makes mistakes, most of all on drawings unlike the training digits, such as a strongly slanted digit, extra marks, or a digit written in an unusual way." />
            </StackPanel>
        </Grid>

        <!-- What it reads: the prediction and the ten probabilities. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="What it reads" />
        <c:Screen ScreenName="probabilities" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,2" c:LiveText.IsLive="True" Text="{Binding PredictionText}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding AnswerText}"
                           Visibility="{Binding AnswerText, Converter={StaticResource VisibleIfSet}}" />
                <StackPanel Visibility="{Binding HasPrediction, Converter={StaticResource VisibleIfTrue}}">
                    <c:ProbabilityBars Items="{Binding Bars}" KeepOrder="True" HighlightedLabel="{Binding HighlightedBar}" MaxWidth="720" HorizontalAlignment="Left"
                                       AutomationProperties.Name="The network's probability for each digit from 0 to 9" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="Softmax turns the network's 10 scores into probabilities that add up to 100%. The chosen digit is the most probable one. The bars' percentages are rounded to two decimals; point at a bar for its exact probability." />
                </StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                    <Run Text="Read by " /><Run Text="{Binding NetworkName, Mode=OneWay}" /><Run Text="." />
                </TextBlock>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,2,0,0" Text="{Binding RecordedAccuracyText}" />
            </StackPanel>
        </c:Screen>

        <!-- Layer by layer: the picture and the feature maps. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="Layer by layer" />
        <c:Screen ScreenName="maps" HorizontalAlignment="Stretch">
            <StackPanel>
                <!-- In a WrapPanel, as in the filters lab, so the 8 by 8 picture keeps its own size instead of filling the pane. -->
                <WrapPanel Visibility="{Binding Image, Converter={StaticResource VisibleIfSet}}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="The picture" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding ImageCaption}"
                                   MaxWidth="{Binding ActualWidth, ElementName=ImageMap}" HorizontalAlignment="Left" />
                        <c:HeatMap x:Name="ImageMap" Values="{Binding Image}" Minimum="0" Maximum="1" HorizontalAlignment="Left"
                                   RowLabels="{x:Static labs:DigitNetworkLabViewModel.PositionLabels}" ColumnLabels="{x:Static labs:DigitNetworkLabViewModel.PositionLabels}"
                                   RowAxisTitle="row" ColumnAxisTitle="column"
                                   AutomationProperties.Name="The picture the network reads: how much ink in each pixel, from 0 to 1" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Visibility="{Binding HasPrediction, Converter={StaticResource VisibleIfTrue}}">
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,2" Text="Layer 1: 16 feature maps, 8 by 8" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4"
                               Text="Each of the 16 learned 3 by 3 filters slides over the picture; its bias is added and numbers below zero are set to 0 (ReLU). White is 0; the redder a square, the more strongly its filter's pattern is there." />
                    <c:FeatureMapGrid Maps="{Binding Layer1Maps}" AutomationProperties.Name="Layer 1 feature maps, 16 maps of 8 by 8" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,8"
                               Text="Max pooling then keeps the largest number in each 2 by 2 block, so each map shrinks to 4 by 4." />
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,2" Text="Layer 2: 32 feature maps, 4 by 4" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4"
                               Text="Each of the 32 filters here reads all 16 pooled maps at once, 3 by 3 squares of each, so it can find combinations of the first layer's patterns. ReLU again." />
                    <c:FeatureMapGrid Maps="{Binding Layer2Maps}" AutomationProperties.Name="Layer 2 feature maps, 32 maps of 4 by 4" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                               Text="Pooling again makes each map 2 by 2: 32 × 4 = 128 numbers. The fully connected layer multiplies all 128 by its weights to give 128 new numbers, with ReLU, and a last layer turns those into the 10 scores." />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding HiddenText}" />
                </StackPanel>
            </StackPanel>
        </c:Screen>

        <!-- Train it again. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="Train it again" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="{Binding TrainingNote}" />
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Seed (for training)" />
            <TextBox MinWidth="110" VerticalAlignment="Center" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>
        <c:Screen ScreenName="training" HorizontalAlignment="Stretch">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Train it again" Command="{Binding TrainAgainCommand}" Margin="0,0,8,0"
                            ToolTip="Train a new network of the same shape from random starting numbers, with the seed" />
                    <Button Content="Stop" Command="{Binding StopTrainingCommand}" ToolTip="End the run early; nothing it trained is used" />
                </WrapPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding TrainingStatus}"
                           Visibility="{Binding TrainingStatus, Converter={StaticResource VisibleIfSet}}" />
                <c:LineChart Series="{Binding TrainingSeries}" XAxisTitle="training step" YAxisTitle="loss" Height="220"
                             Visibility="{Binding HasTrainingSeries, Converter={StaticResource VisibleIfTrue}}"
                             AutomationProperties.Name="Chart of the training loss of your run" />
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,6,0,0" c:LiveText.IsLive="True" Text="{Binding TrainingResult}"
                           Visibility="{Binding TrainingResult, Converter={StaticResource VisibleIfSet}}" />
            </StackPanel>
        </c:Screen>
    </StackPanel>
</UserControl>
