<UserControl x:Class="AIAnatomy.App.Views.LessonPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views">
    <!-- The lab views come from DataTemplates in the window's resources (chosen by view-model type), so the self-test can check them.
         DataContext: MainViewModel (CurrentPage is the open lesson's page; the commands and the layout choice are on the window's view-model).
         The whole page is one vertical scroller: the lab and the explanation have no scroll bars of their own. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <v:NumberStepConverter x:Key="StepNumber" />

        <!-- Final review M2: the explanation's column keeps its minimum width only beside the lab; when the explanation is
             stacked under the lab, the column may shrink, so the window does not need extra width at 24 pt. -->
        <Style x:Key="ExplanationColumn" TargetType="ColumnDefinition">
            <Setter Property="MinWidth" Value="260" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseStackedLayout}" Value="True">
                    <Setter Property="MinWidth" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="True" IsTabStop="True" FocusVisualStyle="{StaticResource InnerFocusRing}"
                  AutomationProperties.Name="Lesson page">
        <StackPanel Margin="4,0,12,16">

            <!-- 1. Path: "2 The parts › 2.4" -->
            <TextBlock Style="{StaticResource MutedText}" Margin="2,0,0,6" Text="{Binding CurrentPage.Path}" />

            <!-- 2. Header band: the part's colour (bar, outline and icon), the title at TitleFontSize, and the big idea. -->
            <Border Style="{StaticResource HeaderBand}" CornerRadius="8" BorderThickness="2" Padding="0" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderBrush}" c:PartResource.BorderBrush="{Binding CurrentPage.Part}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The part's colour as a tint over the band (none for a lesson with no part). -->
                    <Border Grid.ColumnSpan="3" CornerRadius="6" IsHitTestVisible="False" Opacity="{DynamicResource BandTintOpacity}"
                            c:PartResource.Background="{Binding CurrentPage.Part}"
                            Visibility="{Binding CurrentPage.Part, Converter={StaticResource VisibleIfSet}}" />
                    <Border Background="{DynamicResource BorderBrush}" c:PartResource.Background="{Binding CurrentPage.Part}"
                            CornerRadius="6,0,0,6" />
                    <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource TitleFontSize}"
                               Margin="16,10,0,10" VerticalAlignment="Top" Foreground="{DynamicResource MutedTextBrush}"
                               c:PartResource.Foreground="{Binding CurrentPage.Part}"
                               Text="{Binding CurrentPage.Part, Converter={x:Static c:PartResource.GlyphConverter}}"
                               Visibility="{Binding CurrentPage.Part, Converter={StaticResource VisibleIfSet}}"
 />
                    <StackPanel Grid.Column="2" Margin="16,10,16,12">
                        <TextBlock FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding CurrentPage.Title}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding CurrentPage.Idea}"
                                   Visibility="{Binding CurrentPage.Idea, Converter={StaticResource VisibleIfSet}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Try this: hidden when the lesson has no steps. -->
            <Border Margin="0,0,0,12" c:PartResource.BorderBrush="{Binding CurrentPage.Part}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource TryThisBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage.TryThis.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,6" Text="Try this" />
                    <ItemsControl ItemsSource="{Binding CurrentPage.TryThis}" Focusable="False" AlternationCount="100">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,8,0"
                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StepNumber}}" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. The lab and the explanation side by side; the explanation goes under the lab at large text (R32). -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="360" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.25*" Style="{StaticResource ExplanationColumn}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Grid position comes only from these styles (a local Grid.* value would beat the trigger). -->
                <Border c:LessonAnchor.Name="lab" AutomationProperties.Name="Lab pane" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pane}">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseStackedLayout}" Value="True">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl x:Name="LabContent" Content="{Binding CurrentLab}" c:Screen.PartBrush="{Binding CurrentPage.Part}" Focusable="False" IsTabStop="False" />
                </Border>

                <Border c:LessonAnchor.Name="explanation" AutomationProperties.Name="Explanation pane" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pane}">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseStackedLayout}" Value="True">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="Margin" Value="0,12,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PaneTitle}" Text="Explanation" />
                        <c:MarkdownView Document="{Binding Explanation}" />
                        <Expander x:Name="FormulaExpander" c:LessonAnchor.Name="formula" Header="Show formula" Margin="0,12,0,0"
                                  AutomationProperties.Name="Show formula" Visibility="{Binding Formula, Converter={StaticResource VisibleIfSet}}">
                            <c:MarkdownView Document="{Binding Formula}" />
                        </Expander>
                        <Border c:LessonAnchor.Name="brains" Margin="0,20,0,0" Padding="14,10" CornerRadius="8" BorderThickness="6,1,1,1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource WindowBrush}"
                                Visibility="{Binding BrainsAndModels, Converter={StaticResource VisibleIfSet}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,8" Text="Brains and models" />
                                <c:MarkdownView Document="{Binding BrainsAndModels}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Check yourself: shown only for a lesson that has questions (Check is null otherwise, so the slot takes no room). -->
            <ContentControl x:Name="CheckYourselfSlot" Focusable="False" IsTabStop="False" Margin="0,0,0,12" Content="{Binding CurrentPage.Check}">
                <ContentControl.ContentTemplate>
                    <DataTemplate><v:CheckYourselfView /></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- 6. How this connects: a chip for each connection, outlined in the other idea's part colour. Hover or focus shows its sentence. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage.Connections.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,8" Text="How this connects" />
                <ItemsControl ItemsSource="{Binding CurrentPage.Connections}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip}" BorderThickness="2" MinHeight="44"
                                    BorderBrush="{DynamicResource BorderBrush}" c:PartResource.BorderBrush="{Binding Part}"
                                    Command="{Binding DataContext.OpenConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type v:LessonPageView}}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding Sentence}"
                                    AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Sentence}"
                                    GotKeyboardFocus="OnChipFocusChanged" LostKeyboardFocus="OnChipFocusChanged"
                                    MouseEnter="OnChipFocusChanged" MouseLeave="OnChipFocusChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" c:PartResource.Foreground="{Binding Part}"
                                               Text="{Binding Part, Converter={x:Static c:PartResource.GlyphConverter}}"
                                               Visibility="{Binding Part, Converter={StaticResource VisibleIfSet}}"
 />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- The sentence for the chip under the mouse or the keyboard, in words on the page (a tooltip alone would need a mouse). -->
                <TextBlock x:Name="ConnectionNote" Style="{StaticResource BodyText}" Margin="2,4,0,0" MinHeight="{DynamicResource BodyFontSize}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- 7. Back and Next follow the contents order. -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Left" Command="{Binding GoBackCommand}" AutomationProperties.Name="Back to the previous lesson"
                        Visibility="{Binding CurrentPage.PreviousLabel, Converter={StaticResource VisibleIfSet}}">
                    <TextBlock Text="{Binding CurrentPage.PreviousLabel}" TextWrapping="Wrap" />
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Right" Command="{Binding GoNextCommand}" BorderBrush="{DynamicResource AccentBrush}"
                        AutomationProperties.Name="On to the next lesson"
                        Visibility="{Binding CurrentPage.NextLabel, Converter={StaticResource VisibleIfSet}}">
                    <TextBlock Text="{Binding CurrentPage.NextLabel}" TextWrapping="Wrap" />
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
