<UserControl x:Class="AIAnatomy.App.Views.ScaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation">
    <!-- DataContext: ScaleLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <DataTemplate x:Key="PartLine" DataType="{x:Type labs:ParameterRow}">
            <Grid Margin="0,2" AutomationProperties.Name="{Binding Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="PartName" />
                    <ColumnDefinition SharedSizeGroup="PartCount" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,24,0" Text="{Binding Part}" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" Text="{Binding CountText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ModelRow" DataType="{x:Type labs:ScaleRow}">
            <StackPanel Margin="0,0,0,12" AutomationProperties.Name="{Binding Description}">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Label}" />
                <TextBlock TextWrapping="Wrap">
                    <Run FontFamily="{StaticResource NumberFont}" Text="{Binding CountText, Mode=OneWay}" /><Run Text="{Binding Note, Mode=OneWay, StringFormat={} {0}}" />
                </TextBlock>
                <Grid Margin="0,4,0,2" Visibility="{Binding BarFraction, Converter={StaticResource VisibleIfSet}}">
                    <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0">
                        <ItemsControl ItemsSource="{Binding DataContext.DecadeLabels, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1,0,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ProgressBar Minimum="0" Maximum="1" Height="{DynamicResource BodyFontSize}" Foreground="{DynamicResource AccentBrush}"
                                 Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                 Value="{Binding BarFraction, Mode=OneWay, TargetNullValue=0}" />
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="0" TextWrapping="Wrap" Text="{Binding Source, StringFormat={}Source: {0}}"
                           Visibility="{Binding Source, Converter={StaticResource VisibleIfSet}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="How big is our model next to real ones? Size here means the number of learnable numbers (parameters) inside the model." />
        <TextBlock Style="{StaticResource SubheadingText}" Text="Our model, part by part" />
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding OurDescription}" />
        <StackPanel Grid.IsSharedSizeScope="True">
            <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartLine}" Focusable="False" />
        </StackPanel>
        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap">
            <Run Text="Total: " /><Run FontFamily="{StaticResource NumberFont}" Text="{Binding OurCount, Mode=OneWay, StringFormat={}{0:N0}}" />
        </TextBlock>

        <TextBlock Style="{StaticResource SubheadingText}" Text="Next to real models" />
        <TextBlock Style="{StaticResource BodyText}" Text="{x:Static labs:ScaleLabViewModel.ScaleNote}" />
        <ItemsControl ItemsSource="{Binding Models}" ItemTemplate="{StaticResource ModelRow}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding ShortDecadeLabels}" Focusable="False" Margin="0,-6,0,4" AutomationProperties.Name="Scale labels">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:DecadeLabelPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource MutedText}" Margin="3,0,0,0" TextWrapping="NoWrap" FontFamily="{StaticResource NumberFont}" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding AxisText}" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding RatioSentence}" />
    </StackPanel>
</UserControl>
