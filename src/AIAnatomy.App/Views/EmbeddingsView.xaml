<UserControl x:Class="AIAnatomy.App.Views.EmbeddingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls">
    <!-- DataContext: EmbeddingsLabViewModel. -->
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Every token has a list of numbers, its embedding. To draw them, each list is squashed onto a flat picture that keeps as much of the spread as two directions can. Tokens that look close here may still be far apart in the full list of numbers: the percentage under each picture says how much of the spread the picture keeps. Click a point (or use the arrow keys) to see its numbers." />
        <TextBlock Style="{StaticResource PaneTitle}" Text="{Binding TrainedTitle}" />
        <c:ScatterPlot Points="{Binding TrainedPoints}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" Height="480"
                       XAxisTitle="first direction of spread" YAxisTitle="second direction"
                       AutomationProperties.Name="Embedding picture of the model you are using" />
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding TrainedSpreadText}" />
        <TextBlock Style="{StaticResource PaneTitle}" Margin="0,12,0,0" Text="The same model before any training (random numbers)" />
        <c:ScatterPlot Points="{Binding UntrainedPoints}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" Height="480"
                       XAxisTitle="first direction of spread" YAxisTitle="second direction"
                       AutomationProperties.Name="Embedding picture of the untrained model" />
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding UntrainedSpreadText}" />
        <TextBlock Style="{StaticResource MutedText}"
                   Text="␣ is a space, ↵ a new line, � a character the model has never seen. Each group has its own marker shape. The lower picture is a model of this shape before it has learned anything; the upper picture is the model after training." />

        <TextBlock Style="{StaticResource SubheadingText}" Text="One token's numbers" />
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding SelectedSummary}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PaneTitle}" Text="Model you are using" />
                <c:VectorStrip Values="{Binding TrainedVector}" AutomationProperties.Name="Selected token's numbers, model you are using" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource PaneTitle}" Text="Before training" />
                <c:VectorStrip Values="{Binding UntrainedVector}" AutomationProperties.Name="Selected token's numbers, before training" />
            </StackPanel>
        </Grid>

        <WrapPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,8" Text="Seed (for the untrained model's random numbers)" />
            <TextBox Width="110" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>
    </StackPanel>
</UserControl>
