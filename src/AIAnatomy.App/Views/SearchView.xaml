<UserControl x:Class="AIAnatomy.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation"
             x:Name="Root">
    <!-- DataContext: SearchLabViewModel. -->
    <UserControl.Resources>
        <!-- One square of the board: a large X or O; the squares of a winning line get a thick border and bold
             (the status also names the line, so colour is never the only sign). -->
        <Style x:Key="BoardSquare" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="64" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInWinningLine}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="5" />
                    <Setter Property="FontWeight" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The arrow that opens and closes an option; shown only for a move that can open (not at depth 4, not at a
             game's end). The children are searched when it first opens, so the arrow does not wait for them to exist. -->
        <Style x:Key="LookAheadArrow" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="{DynamicResource ScrollBarSize}" MinHeight="24">
                            <TextBlock x:Name="Glyph" Text="▸" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ScreenTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Glyph" Property="Text" Value="▾" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LookAheadItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource ScreenTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="ToolTip" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Style="{StaticResource LookAheadArrow}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Border x:Name="Row" Grid.Column="1" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Margin="0,1">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
                            <DataTrigger Binding="{Binding CanExpand}" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type labs:LookAheadNode}" ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource LookAheadItem}">
            <TextBlock x:Name="Label" Text="{Binding Label}" TextWrapping="Wrap" Margin="2,3,4,3" />
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True"><Setter TargetName="Label" Property="FontWeight" Value="Bold" /></DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Play tic-tac-toe against a computer that looks ahead to the end of every game before it moves." />
        <WrapPanel Margin="0,0,0,4">
            <Button Content="New game: you play X (you go first)" Command="{Binding NewGameAsXCommand}"
                    ToolTip="Start again with an empty board; you move first" />
            <Button Content="New game: you play O (the computer goes first)" Command="{Binding NewGameAsOCommand}"
                    ToolTip="Start again with an empty board; the computer moves first" />
        </WrapPanel>

        <!-- The two screens: side by side, one above the other when the pane is narrow (see the code-behind). -->
        <Grid x:Name="Screens" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="Auto" />
                <ColumnDefinition x:Name="Gap" Width="16" />
                <ColumnDefinition x:Name="SecondColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <c:Screen x:Name="BoardPanel" Grid.Column="0" ScreenName="board" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="The board" />
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,8" c:LiveText.IsLive="True" Text="{Binding StatusText}"
                               MaxWidth="354" HorizontalAlignment="Left" />
                    <!-- Three squares of 112 plus their 3 px margins each way: 354 a side. A fixed size, so the line overlay
                         below cannot stretch the board. -->
                    <Grid HorizontalAlignment="Left" Width="354" Height="354">
                        <ItemsControl x:Name="BoardSquares" ItemsSource="{Binding Cells}" Focusable="False" AutomationProperties.Name="Board">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BoardSquare}" Content="{Binding Text}"
                                            AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding AutomationName}"
                                            Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding Index}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The winning line, drawn across the squares' centres (on a 3 by 3 grid of 100-unit squares). -->
                        <Viewbox Stretch="Fill" IsHitTestVisible="False">
                            <Canvas Width="300" Height="300">
                                <Line x:Name="WinLine" Visibility="Collapsed" Stroke="{DynamicResource AccentBrush}" StrokeThickness="9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </StackPanel>
            </c:Screen>

            <c:Screen x:Name="LookAheadPanel" Grid.Column="2" ScreenName="lookahead" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="Look-ahead: the options the computer weighed for its latest move" />
                    <TextBlock x:Name="CountLine" Style="{StaticResource BodyText}" Margin="0,0,0,6" c:LiveText.IsLive="True" Text="{Binding CountText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="Waiting" Style="{StaticResource BodyText}" Margin="0,0,0,6"
                               Text="Nothing yet: the computer has not moved." />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6" Foreground="{DynamicResource ScreenTextBrush}" Opacity="0.85"
                               FontSize="{DynamicResource SmallFontSize}"
                               Text="Every score is from the computer's point of view. Open an option to see your replies beneath it (click its arrow, or press Right arrow, Enter or Space; Left arrow, Enter or Space closes it again), and open a reply to see the computer's answers, up to four moves ahead." />
                    <TreeView x:Name="Tree" ItemsSource="{Binding LookAhead}" ItemContainerStyle="{StaticResource LookAheadItem}"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ScreenTextBrush}"
                              KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Look-ahead"
                              PreviewKeyDown="OnTreeKeyDown">
                        <TreeView.Template>
                            <ControlTemplate TargetType="TreeView">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </TreeView.Template>
                    </TreeView>
                </StackPanel>
            </c:Screen>
        </Grid>
    </StackPanel>
</UserControl>
