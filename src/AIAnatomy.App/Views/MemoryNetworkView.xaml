<UserControl x:Class="AIAnatomy.App.Views.MemoryNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation">
    <!-- DataContext: MemoryNetworkLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="A memory network (a recurrent network) and the Fables transformer, both trained on the same fables. The memory network reads one character at a time and carries one vector of numbers, its memory, from each character to the next." />
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,4,0,6" TextWrapping="Wrap"
                   c:LiveText.IsLive="True" Text="{Binding LoadMessage}"
                   Visibility="{Binding LoadMessage, Converter={StaticResource VisibleIfSet}}" />
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Seed (for the samples and for training)" />
            <TextBox MinWidth="110" VerticalAlignment="Center" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>

        <!-- The comparison table: every number says how it was obtained. -->
        <c:Screen ScreenName="compare" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="Loss and training speed" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="Network" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="How the numbers were got" />
                    <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="Validation loss" />
                    <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="Characters a second in training" />
                    <TextBlock Grid.Column="4" Style="{StaticResource MutedText}" FontWeight="SemiBold" Text="Size" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Comparison}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type labs:ComparisonRow}">
                            <Grid Margin="0,2,0,2" Focusable="True" AutomationProperties.HelpText="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.8*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding Network}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,8,0" Text="{Binding Kind}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource BodyText}" Margin="0,0,8,0" FontFamily="{StaticResource NumberFont}" Text="{Binding Loss}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource BodyText}" Margin="0,0,8,0" FontFamily="{StaticResource NumberFont}" Text="{Binding Speed}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource BodyText}" Text="{Binding Size}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="{x:Static labs:MemoryNetworkLabViewModel.LossNote}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{x:Static labs:MemoryNetworkLabViewModel.SpeedNote}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{x:Static labs:MemoryNetworkLabViewModel.LiveSpeedNote}"
                           Visibility="{Binding HasLiveValues, Converter={StaticResource VisibleIfTrue}}" />
            </StackPanel>
        </c:Screen>

        <!-- How far back it remembers: loss by position, measured live on both networks. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="How far back it remembers" />
        <TextBlock Style="{StaticResource BodyText}"
                   Text="The loss at each position of the same 32 windows, measured on both networks when the lab opened. At position 1 a network has read one character; at 64 it has read 64. A curve that keeps falling means the network is using older characters." />
        <c:Screen ScreenName="memory" HorizontalAlignment="Stretch">
            <StackPanel>
                <c:LineChart x:Name="MemoryChart" Series="{Binding MemorySeries}" XAxisTitle="characters read" YAxisTitle="loss" Height="280"
                             AutomationProperties.Name="Chart of each network's loss against the number of characters read" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,6" Text="{x:Static labs:MemoryNetworkLabViewModel.MemoryNote}" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="Characters read" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="Transformer" />
                    <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontWeight="SemiBold" Text="Memory network" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MemoryBands}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type labs:MemoryBand}">
                            <Grid Margin="0,1,0,1" Focusable="True" AutomationProperties.HelpText="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Margin="0,0,8,0" Text="{Binding CharactersRead}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,8,0" FontFamily="{StaticResource NumberFont}" Text="{Binding TransformerText}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource BodyText}" FontFamily="{StaticResource NumberFont}" Text="{Binding MemoryText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" c:LiveText.IsLive="True" Text="{Binding MemoryFinding}" />
            </StackPanel>
        </c:Screen>

        <!-- The hidden state: the memory after each character. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="The memory, after each character" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="Your text (also the start of the samples below)" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Your text" />
        <c:Screen ScreenName="hidden" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,0" c:LiveText.IsLive="True" Text="{Binding Message}"
                           Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,4" Text="{Binding HiddenCaption}" />
                <WrapPanel Margin="0,0,0,4" Visibility="{Binding SelectedBlock, Converter={StaticResource VisibleIfSet}}">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Show" />
                    <ComboBox ItemsSource="{Binding HiddenBlocks}" DisplayMemberPath="Title" SelectedIndex="{Binding SelectedBlockIndex}" MinWidth="180"
                              AutomationProperties.Name="Which units of the memory to show" />
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" Text="(32 at a time)" />
                </WrapPanel>
                <!-- Scrolls sideways when the pane is too narrow for squares as tall as a row label. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False"
                              Visibility="{Binding SelectedBlock, Converter={StaticResource VisibleIfSet}}">
                    <v:HiddenStateBlockView DataContext="{Binding SelectedBlock}" HorizontalAlignment="Left" />
                </ScrollViewer>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,0"
                           Text="Light squares are near −1 and dark squares near 1. ␣ is a space, ↵ a new line and � a character the network never saw." />
            </StackPanel>
        </c:Screen>

        <!-- Samples from both networks. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="What each network writes" />
        <c:Screen ScreenName="samples" HorizontalAlignment="Stretch">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Write 200 characters with each" Command="{Binding GenerateSamplesCommand}" Margin="0,0,8,0"
                            ToolTip="Both networks continue your text, one random draw at a time, at temperature 0.8 with the seed" />
                </WrapPanel>
                <TextBlock Style="{StaticResource BodyText}" c:LiveText.IsLive="True" Text="{Binding SampleStatus}"
                           Visibility="{Binding SampleStatus, Converter={StaticResource VisibleIfSet}}" />
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,6,0,2" Text="Transformer" />
                <TextBlock Style="{StaticResource BodyText}" FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding TransformerSample}" />
                <TextBlock Style="{StaticResource PaneTitle}" Margin="0,6,0,2" Text="Memory network" />
                <TextBlock Style="{StaticResource BodyText}" FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding RnnSample}" />
            </StackPanel>
        </c:Screen>

        <!-- Train it again: the memory network only. -->
        <TextBlock Style="{StaticResource SubheadingText}" Margin="0,12,0,4" Text="Train it again" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="{Binding TrainingNote}" />
        <c:Screen ScreenName="training" HorizontalAlignment="Stretch">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Train it again" Command="{Binding TrainAgainCommand}" Margin="0,0,8,0"
                            ToolTip="Train a new, smaller memory network from random starting numbers, with the seed" />
                    <Button Content="Stop" Command="{Binding StopTrainingCommand}" ToolTip="End the run early; nothing it trained is used" />
                </WrapPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding TrainingStatus}"
                           Visibility="{Binding TrainingStatus, Converter={StaticResource VisibleIfSet}}" />
                <c:LineChart x:Name="TrainingChart" Series="{Binding TrainingSeries}" XAxisTitle="training step" YAxisTitle="loss" Height="220"
                             Visibility="{Binding HasTrainingSeries, Converter={StaticResource VisibleIfTrue}}"
                             AutomationProperties.Name="Chart of the training loss of your run" />
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,6,0,0" c:LiveText.IsLive="True" Text="{Binding TrainingResult}"
                           Visibility="{Binding TrainingResult, Converter={StaticResource VisibleIfSet}}" />
            </StackPanel>
        </c:Screen>
    </StackPanel>
</UserControl>
