<UserControl x:Class="AIAnatomy.App.Views.ComingLaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: ComingLaterLabViewModel. -->
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8" Padding="20,16"
            Background="{DynamicResource WindowBrush}" HorizontalAlignment="Left" MaxWidth="900">
        <StackPanel>
            <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,8" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0" Text="The explanation for this lesson is on the right." />
        </StackPanel>
    </Border>
</UserControl>
