<UserControl x:Class="AIAnatomy.App.Views.FeedForwardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation">
    <!-- DataContext: FeedForwardLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <DataTemplate x:Key="ContextLine" DataType="{x:Type labs:ContextRow}">
            <StackPanel Orientation="Horizontal" Margin="0,2" AutomationProperties.Name="{Binding Description}">
                <TextBlock MinWidth="48" Margin="0,0,8,0" Text="{Binding Rank, StringFormat={}{0}.}" Style="{StaticResource MutedText}" />
                <TextBlock MinWidth="96" Margin="0,0,8,0" FontFamily="{StaticResource NumberFont}" Text="{Binding ValueText}" />
                <TextBlock FontFamily="{StaticResource NumberFont}" Text="{Binding Before}" />
                <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="2" Padding="3,0" Margin="1,0">
                    <TextBlock FontFamily="{StaticResource NumberFont}" FontWeight="Bold" Text="{Binding Own}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="After attention, every token's vector goes, on its own, through the same small network: the feed-forward layer. It is made of many neurons, each giving a number that is high or low depending on the input. Pick one neuron and see where it fires." />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
        <StackPanel Visibility="{Binding HasFeedForward, Converter={StaticResource VisibleIfTrue}}">
            <WrapPanel Margin="0,4,0,8">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Layer" />
                <ComboBox Width="80" Margin="0,0,16,4" ItemsSource="{Binding LayerNumbers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Layer" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,4" Text="Neuron" />
                <ComboBox Width="100" Margin="0,0,16,4" ItemsSource="{Binding NeuronNumbers}" SelectedItem="{Binding Neuron}" AutomationProperties.Name="Neuron" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SubheadingText}" Text="Along your text" />
            <TextBlock Style="{StaticResource MutedText}" Text="Your text" Margin="0,0,0,2" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" AutomationProperties.Name="Your text" />
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource VisibleIfSet}}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding ActivationCaption}" />
            <c:VectorStrip Values="{Binding Activations}" AutomationProperties.Name="Activation of the chosen neuron along your text" />
            <TextBlock Style="{StaticResource MutedText}" Text="The bars, left to right, numbered from 0 as under the bars (␣ is a space, ↵ a new line, � a character the model has never seen):" Margin="0,4,0,0" />
            <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding TokenKey}" />

            <TextBlock Style="{StaticResource SubheadingText}" Text="Where this neuron fires most" />
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding ContextsStatus}" />
            <TextBlock Style="{StaticResource MutedText}" Text="Each line: the activation, then the text just before, ending with the character the neuron had just read (bold, in a box). ␣ is a space, ↵ a new line." />
            <ItemsControl ItemsSource="{Binding Contexts}" ItemTemplate="{StaticResource ContextLine}" Focusable="False" />
        </StackPanel>
        <Border Style="{StaticResource Pane}" Padding="12" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource BodyText}" Text="{x:Static labs:FeedForwardLabViewModel.ResearchNote}" />
        </Border>
    </StackPanel>
</UserControl>
