<UserControl x:Class="AIAnatomy.App.Views.TokensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation">
    <!-- DataContext: TokensLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
        <DataTemplate x:Key="Chip" DataType="{x:Type labs:TokenChip}">
            <Border x:Name="Frame" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6"
                    Background="{DynamicResource WindowBrush}" Margin="0,0,6,6" Padding="8,4" MinWidth="40">
                <StackPanel>
                    <TextBlock x:Name="Piece" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding Text}" />
                    <TextBlock FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                               Text="{Binding Id, StringFormat=id {0}}" />
                    <TextBlock FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                               Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource VisibleIfSet}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- An unknown character is marked by a thicker outline and the replacement mark, not by colour. -->
                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                    <Setter TargetName="Frame" Property="BorderThickness" Value="3.5" />
                    <Setter TargetName="Frame" Property="ToolTip" Value="A character the tokenizer has never seen" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel /></ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="The same text cut up two ways. A token is the unit the model reads; each one has a number, its id." />
        <TextBlock Style="{StaticResource MutedText}" Text="Your text" Margin="0,0,0,2" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap"
                 MaxHeight="140" AutomationProperties.Name="Your text" />
        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}"
                   Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Style="{StaticResource MutedText}" Text="␣ is a space and ↵ a new line; � stands for a character the tokenizer has never seen." />

        <TextBlock Style="{StaticResource SubheadingText}" Text="One token per character" />
        <c:Screen ScreenName="characters" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding CharacterCountText}" />
                <ItemsControl ItemsSource="{Binding CharacterChips}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
            </StackPanel>
        </c:Screen>

        <StackPanel c:LessonAnchor.Name="bpe">
        <TextBlock Style="{StaticResource SubheadingText}" Text="Byte-pair encoding (BPE)" />
        <TextBlock Style="{StaticResource MutedText}"
                   Text="Starts with single characters, then repeatedly joins the pair that occurs most often in the fables. Each join is one merge." />
        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,12" Text="Merges" />
            <Slider Width="320" Minimum="0" Maximum="500" SmallChange="1" LargeChange="25" TickFrequency="50"
                    Value="{Binding Merges, Mode=TwoWay}" AutomationProperties.Name="Merges" Margin="0,0,12,12" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,12" Text="{Binding Merges}" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding BpeStatus}" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding BpeStatus, Converter={StaticResource VisibleIfSet}}" />
        <c:Screen ScreenName="pieces" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding BpeCountText}" />
                <ItemsControl ItemsSource="{Binding BpeChips}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
            </StackPanel>
        </c:Screen>
        </StackPanel>

        <StackPanel c:LessonAnchor.Name="count-letters">
        <TextBlock Style="{StaticResource SubheadingText}" Text="Count the letters" />
        <TextBlock Style="{StaticResource MutedText}" Text="Pick a word and a letter. The chips are the pieces the BPE sees, with the letter counted inside each." />
        <WrapPanel>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,8" Text="Word" />
            <TextBox MinWidth="260" Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Word" />
            <TextBlock VerticalAlignment="Center" Margin="16,0,8,8" Text="Letter" />
            <TextBox MinWidth="70" Text="{Binding Letter, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" AutomationProperties.Name="Letter" />
        </WrapPanel>
        <c:Screen ScreenName="word" HorizontalAlignment="Stretch">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding WordChips}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding WordSummary}" />
            </StackPanel>
        </c:Screen>
        </StackPanel>
    </StackPanel>
</UserControl>
