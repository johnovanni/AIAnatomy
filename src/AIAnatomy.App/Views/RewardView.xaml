<UserControl x:Class="AIAnatomy.App.Views.RewardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views"
             xmlns:labs="clr-namespace:AIAnatomy.Presentation.Labs;assembly=AIAnatomy.Presentation">
    <!-- DataContext: RewardLabViewModel. -->
    <UserControl.Resources>
        <v:NullToCollapsedConverter x:Key="VisibleIfSet" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="The agent starts at S and has to find G. Nobody shows it the way: it gets the goal reward for reaching the goal and loses the step cost for every other move. Step makes one move; Run plays up to 300 episodes. Choose a tool and click squares to change the maze." />

        <!-- The tool, the four sliders with their values, and the seed. -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" Text="Tool:" />
            <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                <RadioButton GroupName="MazeTool" Content="Wall (add or remove)" IsChecked="{Binding IsWallTool}" Margin="0,0,18,0" />
                <RadioButton GroupName="MazeTool" Content="Move the start (S)" IsChecked="{Binding IsStartTool}" Margin="0,0,18,0" />
                <RadioButton GroupName="MazeTool" Content="Move the goal (G)" IsChecked="{Binding IsGoalTool}" />
            </WrapPanel>

            <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" Text="{Binding GoalRewardText}" />
            <Slider Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" MinWidth="240" HorizontalAlignment="Left"
                    Minimum="{Binding Source={x:Static labs:RewardLabViewModel.MinGoalReward}}" Maximum="{Binding Source={x:Static labs:RewardLabViewModel.MaxGoalReward}}"
                    SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GoalReward, Mode=TwoWay}"
                    AutomationProperties.Name="Goal reward: the reward for stepping into the goal" ToolTip="The reward for stepping into the goal" />

            <TextBlock Grid.Row="2" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" Text="{Binding StepCostText}" />
            <Slider Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" MinWidth="240" HorizontalAlignment="Left"
                    Minimum="{Binding Source={x:Static labs:RewardLabViewModel.MinStepCost}}" Maximum="{Binding Source={x:Static labs:RewardLabViewModel.MaxStepCost}}"
                    SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding StepCost, Mode=TwoWay}"
                    AutomationProperties.Name="Step cost: what every other move costs" ToolTip="What every move that does not reach the goal costs" />

            <TextBlock Grid.Row="3" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" Text="{Binding ExplorationRateText}" />
            <Slider Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" MinWidth="240" HorizontalAlignment="Left"
                    Minimum="{Binding Source={x:Static labs:RewardLabViewModel.MinExplorationRate}}" Maximum="{Binding Source={x:Static labs:RewardLabViewModel.MaxExplorationRate}}"
                    SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding ExplorationRate, Mode=TwoWay}"
                    AutomationProperties.Name="Exploration rate: the chance of a random move" ToolTip="The chance of trying a random move instead of the best known one (changing it keeps what was learned)" />

            <TextBlock Grid.Row="4" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" Text="{Binding DiscountText}" />
            <Slider Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" MinWidth="240" HorizontalAlignment="Left"
                    Minimum="{Binding Source={x:Static labs:RewardLabViewModel.MinDiscount}}" Maximum="{Binding Source={x:Static labs:RewardLabViewModel.MaxDiscount}}"
                    SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Discount, Mode=TwoWay}"
                    AutomationProperties.Name="Discount: how much a reward one step later counts" ToolTip="How much a reward one step later counts" />
        </Grid>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                   Text="Changing the maze, the goal reward, the step cost, the discount or the seed starts the learning again; the exploration rate does not." />

        <WrapPanel Margin="0,0,0,8">
            <Button Content="Step" Command="{Binding StepCommand}" ToolTip="Make one move and learn from it" Margin="0,0,8,8" />
            <Button Content="Run" Command="{Binding RunCommand}" ToolTip="Play up to 300 episodes" Margin="0,0,8,8" />
            <Button Content="Stop" Command="{Binding RunCancelCommand}" ToolTip="Stop after the episode under way" Margin="0,0,24,8" />
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,8" Text="Seed (for the random moves)" />
            <TextBox MinWidth="110" Margin="0,0,0,8" VerticalAlignment="Center" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>

        <!-- The two screens: side by side, one above the other when the pane is narrow (see the code-behind). -->
        <Grid x:Name="Screens">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="3*" />
                <ColumnDefinition x:Name="Gap" Width="16" />
                <ColumnDefinition x:Name="SecondColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <c:Screen x:Name="ValuesPanel" Grid.Column="0" ScreenName="values" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="The maze: each square's value and the move the agent prefers" />
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,6" TextWrapping="Wrap"
                               c:LiveText.IsLive="True" Text="{Binding Message}"
                               Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />
                    <c:GridWorldView x:Name="Maze" Squares="{Binding Squares}" AutomationProperties.Name="Maze" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Readout" Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold"
                               Text="{Binding ReadoutText, ElementName=Maze, NotifyOnTargetUpdated=True}" Binding.TargetUpdated="OnReadoutUpdated"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="S is the start and G the goal; the ring is the agent, and each arrow is the move it prefers there (no arrow while no single move is best). Darker squares are worth more. Squares are numbered column, then row, from the top left." />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                               c:LiveText.IsLive="True" Text="{Binding LastStepText}"
                               Visibility="{Binding LastStepText, Converter={StaticResource VisibleIfSet}}" />
                </StackPanel>
            </c:Screen>

            <c:Screen x:Name="EpisodesPanel" Grid.Column="2" ScreenName="episodes" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="Episodes: from the start to the goal" />
                    <TextBlock x:Name="EpisodesLine" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6"
                               Text="{Binding EpisodesText, NotifyOnTargetUpdated=True}" Binding.TargetUpdated="OnEpisodesUpdated"
                               AutomationProperties.LiveSetting="Polite" />
                    <c:LineChart x:Name="StepsChart" Series="{Binding StepsSeries}" XAxisTitle="episode" YAxisTitle="steps" Height="220"
                                 AutomationProperties.Name="Chart of the steps each episode took" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="An episode ends at the goal, or after 200 steps; then the agent goes back to the start. Fewer steps means it has learned a shorter way." />
                </StackPanel>
            </c:Screen>
        </Grid>
    </StackPanel>
</UserControl>
