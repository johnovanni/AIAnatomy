<UserControl x:Class="AIAnatomy.App.Views.RulesVsLearningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views">
    <!-- DataContext: RulesVsLearningLabViewModel. -->
    <UserControl.Resources><v:NullToCollapsedConverter x:Key="VisibleIfSet" /></UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Both writers predict the next character, one character at a time, starting from the same text." />
        <TextBlock Style="{StaticResource MutedText}" Text="Start text" Margin="0,0,0,2" />
        <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Start text" />
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" FontWeight="SemiBold"
                   Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />

        <TextBlock Style="{StaticResource MutedText}" Text="↵ is a new line; � stands for a character the model has never seen." />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,6" Text="{Binding LearnBlurb}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Learn" Command="{Binding LearnCommand}" ToolTip="{Binding LearnToolTip}" />
            <Button Content="Stop" Command="{Binding LearnCancelCommand}" ToolTip="Stop training after the current chunk" />
        </StackPanel>

        <!-- The two output screens: side by side, one above the other when the pane is narrow (see the code-behind). -->
        <Grid x:Name="Screens">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="Gap" Width="16" />
                <ColumnDefinition x:Name="SecondColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="RulesPanel" Grid.Column="0">
                <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,2" Text="Written rules" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="Rules a person wrote down. They never change." />
                <c:Screen ScreenName="rules" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="What the rules write" />
                        <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding RuleOutput}"
                                   Foreground="{DynamicResource TextBrush}" AutomationProperties.HelpText="What the rules write" />
                    </StackPanel>
                </c:Screen>
            </StackPanel>

            <StackPanel x:Name="LearnedPanel" Grid.Column="2">
                <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,2" Text="Learned from examples" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="{Binding HistoryHeading}" />
                <c:Screen ScreenName="learned" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="After each press of Learn (newest first)" />
                        <ItemsControl ItemsSource="{Binding History}" AlternationCount="100" Focusable="False" AutomationProperties.Name="Learned history">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bar" BorderThickness="4,0,0,0" Padding="8,2,0,2" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource BorderBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Newest" Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextBrush}" Text="Newest" Visibility="Collapsed" />
                                                <TextBlock x:Name="Label" Style="{StaticResource MutedText}" Text="{Binding Label}" />
                                            </StackPanel>
                                            <TextBlock x:Name="Written" FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding Text}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                            <Setter TargetName="Newest" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter TargetName="Written" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter TargetName="Bar" Property="c:PartResource.BorderBrush"
                                                    Value="{Binding Path=(c:Screen.PartBrush), RelativeSource={RelativeSource Self}}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:Screen>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" Text="{Binding LossText}" />

        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,4" Text="The written rules, in order. The first one that fits wins." />
        <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <c:LineChart Series="{Binding LossSeries}" XAxisTitle="training step" YAxisTitle="loss" Height="180" Margin="0,8,0,0"
                     MinXSpan="{Binding LossAxisMinimumSteps}" />

        <WrapPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,8" Text="Seed (for the learned model's random choices)" />
            <TextBox MinWidth="110" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>
    </StackPanel>
</UserControl>
