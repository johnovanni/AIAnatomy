<UserControl x:Class="AIAnatomy.App.Views.RulesVsLearningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AIAnatomy.App.Controls"
             xmlns:v="clr-namespace:AIAnatomy.App.Views">
    <!-- DataContext: RulesVsLearningLabViewModel. -->
    <UserControl.Resources><v:NullToCollapsedConverter x:Key="VisibleIfSet" /></UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Both writers predict the next character, one character at a time, starting from the same text." />
        <TextBlock Style="{StaticResource MutedText}" Text="Start text" Margin="0,0,0,2" />
        <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Start text" />
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" FontWeight="SemiBold"
                   Visibility="{Binding Message, Converter={StaticResource VisibleIfSet}}" />

        <TextBlock Style="{StaticResource MutedText}" Text="↵ is a new line; � stands for a character the model has never seen." />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Pane}" Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,8" Text="Hand-written rules" />
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,0,0,4" Text="What the rules write" />
                    <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding RuleOutput}"
                               AutomationProperties.Name="Rule output" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource MutedText}" Text="The rules, in order. The first one that fits wins." />
                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Pane}" Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,8" Text="A model that learns" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="A table of scores: one row per character, one column per possible next character. It learns from the opening pages of the fables, 20 steps at a time." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Learn" Command="{Binding LearnCommand}" ToolTip="Train in chunks of 20 steps" />
                        <Button Content="Stop" Command="{Binding LearnCancelCommand}" ToolTip="Stop training after the current chunk" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PaneTitle}" Margin="0,8,0,4" Text="What the learned model writes" />
                    <TextBlock FontFamily="{StaticResource NumberFont}" TextWrapping="Wrap" Text="{Binding LearnedOutput}"
                               AutomationProperties.Name="Learned output" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,4" Text="{Binding LossText}" />
                    <c:LineChart Series="{Binding LossSeries}" XAxisTitle="training step" YAxisTitle="loss" Height="260" />
                </StackPanel>
            </Border>
        </Grid>

        <WrapPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,8" Text="Seed (for the learned model's random choices)" />
            <TextBox Width="110" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seed" />
        </WrapPanel>
    </StackPanel>
</UserControl>
